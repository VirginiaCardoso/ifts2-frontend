import { useState, useEffect } from 'react';
import { ingresantesService } from '../../services/ingresantesService';
import { formatearFecha } from '../../utils/dateUtils';

export function useIngresantes() {
    
    const [etapas, setEtapas] = useState([]);
    const [error, setError] = useState(null);

    const [editandoId, setEditandoId] = useState(null);
    const [etapaAEliminar, setEtapaAEliminar] = useState(null);
    const [eliminandoEtapa, setEliminandoEtapa] = useState(false);
    const [mostrarFormularioNuevo, setMostrarFormularioNuevo] = useState(false);
    const [creandoEtapa, setCreandoEtapa] = useState(false);
    const [formNuevaEtapa, setFormNuevaEtapa] = useState({
        anio: '',
        nombre: '',
        descripcion: '',
        fecha_inicio: '',
        fecha_fin: '',
        requisitos: '',
        orden: ''
    });
    const [formEditado, setFormEditado] = useState({
            nombre: '',
            anio: '',
            fecha_inicio: '',
            fecha_fin: '',
            descripcion: '',
            requisitos: '',
            orden: '',
    });

    // Estados para el manejo del PDF
    const [documentoActual, setDocumentoActual] = useState(null);
    const [loading, setLoading] = useState(true);
    const [archivoSeleccionado, setArchivoSeleccionado] = useState(null);

    //cargar datos desde backend al iniciar
    const cargarDatos = async () => {
        try {
            setLoading(true);
            const data = await ingresantesService.obtenerDatosIngresantes();
            setEtapas(Array.isArray(data) ? data : []);
            setError(null);

        } catch (err) {
            setError(err.message);
        } finally {
            setLoading(false);
        }
    };

    useEffect(() => {
        cargarDatos();
    }, []);

    // Cargar el documento actual de la base de datos al iniciar
    const cargarDocumento = async () => {
        try {
           // setLoading(true);
            //const data = await ingresantesService.obtenerDocumento();
            //setDocumentoActual(data); 
            setDocumentoActual({ nombre: 'ingresantes.pdf' });
        } catch (err) {
            console.log("Documento omitido temporalmente");
            //console.error('Error al obtener el documento:', err);
        } finally {
            setLoading(false);
        }
    };

    useEffect(() => {
        cargarDocumento();
    }, []);

    // para cuando el usuario selecciona un archivo
    const handleFileChange = (e) => {
        const file = e.target.files[0];
        if (file) {
            setArchivoSeleccionado(file);
        }
    };

    // Enviar el PDF al backend usando el servicio
    const handleSubirPdf = async () => {
        if (!archivoSeleccionado) return;

        try {
            const formData = new FormData();
           
            formData.append('documento', archivoSeleccionado);

            await ingresantesService.actualizarDocumento(formData);
            alert('PDF actualizado con éxito');
            setArchivoSeleccionado(null);
            cargarDocumento(); // Recargamos para mostrar el nuevo archivo actual
        } catch (err) {
            alert(err.message);
        }
    };

    const handleEditarEtapa = (id) => {
        
        const etapaAEditar = etapas.find(e => e.id_etapa === id);

        if (etapaAEditar) {
            setEditandoId(id);
            setFormEditado({
                nombre: etapaAEditar.nombre || '',
                anio: etapaAEditar.anio || '',
                fecha_inicio: etapaAEditar.fecha_inicio ? etapaAEditar.fecha_inicio.split('T')[0] : '',
                fecha_fin: etapaAEditar.fecha_fin ? etapaAEditar.fecha_fin.split('T')[0] : '',
                descripcion: etapaAEditar.descripcion || '',
                requisitos: etapaAEditar.requisitos || '',
                orden: etapaAEditar.orden ?? ''
            })
        }
    };

    //Handle para guardar los cambios editados
    const handleGuardarEdicion = async (id_etapa) => {
        try{
            await ingresantesService.actualizarEtapa(id_etapa, {
                ...formEditado,
                orden: Number(formEditado.orden)
            });
            //cerramos el formulario de edición limpiando el id
            setEditandoId(null);
            //recargamos los datos
            await cargarDatos();
        } catch(err){
            console.error("Error al guardar la etapa:", err);
            setError(err.message);
        }
    };

    const handleCrearEtapa = async () => {
        try {
            setCreandoEtapa(true);
            await ingresantesService.crearEtapa({
                ...formNuevaEtapa,
                anio: Number(formNuevaEtapa.anio),
                orden: Number(formNuevaEtapa.orden)
            });
            setFormNuevaEtapa({
                anio: '',
                nombre: '',
                descripcion: '',
                fecha_inicio: '',
                fecha_fin: '',
                requisitos: '',
                orden: ''
            });
            setMostrarFormularioNuevo(false);
            await cargarDatos();
        } catch (err) {
            console.error('Error al crear la etapa:', err);
            setError(err.message);
        } finally {
            setCreandoEtapa(false);
        }
    };

    //Handle para eliminar etapa
    const handleEliminarEtapa = (id_etapa) => {
        setEtapaAEliminar(etapas.find((etapa) => etapa.id_etapa === id_etapa) || { id_etapa });
    };

    const confirmarEliminarEtapa = async () => {
        if (!etapaAEliminar) return;
        try {
            setEliminandoEtapa(true);
            await ingresantesService.eliminarEtapa(etapaAEliminar.id_etapa);
            setEtapaAEliminar(null);
            await cargarDatos();
        } catch (err){
            console.error("Error al eliminar la etapa:", err);
            setError(err.message);
        } finally {
            setEliminandoEtapa(false);
        }
    };

    return {
        etapas,
        etapaAEliminar,
        setEtapaAEliminar,
        eliminandoEtapa,
        confirmarEliminarEtapa,
        documentoActual,
        loading,
        error,
        mostrarFormularioNuevo,
        setMostrarFormularioNuevo,
        creandoEtapa,
        formNuevaEtapa,
        setFormNuevaEtapa,
        handleCrearEtapa,
        archivoSeleccionado,
        formatearFecha,
        handleFileChange,
        handleSubirPdf,
        handleEditarEtapa,
        handleGuardarEdicion,
        handleEliminarEtapa,
        editandoId,
        setEditandoId,
        formEditado,
        setFormEditado,
        cargarDatos
    };
}